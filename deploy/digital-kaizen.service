# systemd unit for Linux. Installed by deploy/install-linux-service.sh,
# which fills in the folder, the user and the path to node.
[Unit]
Description=Digital Kaizen dashboard
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__NODE__ --env-file-if-exists=.env src/run.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
