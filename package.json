{
  "name": "digital-kaizen",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Digital Kaizen: live shot counting, downtime and defect logging by QR, OEE and an escalation ladder for injection-moulding machines. ToF sensor -> MQTT -> database -> dashboard.",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/run.js",
    "setup": "node --env-file-if-exists=.env scripts/setup.js",
    "check": "node --env-file-if-exists=.env scripts/check.js",
    "demo": "node src/run.js",
    "seed": "node scripts/seed-history.js",
    "reset": "node --env-file-if-exists=.env scripts/reset-db.js",
    "test": "node --test && node scripts/verify-guards.js",
    "admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "mail-sink": "node scripts/smtp-sink.js",
    "upgrade-check": "node scripts/upgrade.js --check",
    "rollback": "node scripts/rollback.js"
  },
  "dependencies": {
    "aedes": "^0.51.3",
    "mqtt": "^5.10.1",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "mailparser": "^3.14.1",
    "smtp-server": "^3.21.3"
  }
}
