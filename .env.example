# Digital Kaizen settings. "npm run setup" writes this file for you as .env.
# Edit with any text editor, then restart the app.

# The MQTT broker the sensors already publish to. This app only listens on it.
# Leave DK_BROKER_URL empty to run the built-in demo instead (simulated machines).
DK_BROKER_URL=mqtt://127.0.0.1:1883
DK_BROKER_USER=
DK_BROKER_PASS=

# The first part of the topic the sensors publish on. Must match the sensor file.
DK_TOPIC_ROOT=factory-demo-9f7c2a61

# The port the dashboard is served on.
DK_WEB_PORT=4310

# Optional: email alerts when a machine stops. Leave out to switch alerts off.
# DK_SMTP_HOST=
# DK_SMTP_PORT=587
# DK_SMTP_USER=
# DK_SMTP_PASS=
# DK_MAIL_FROM=
# DK_MAIL_TO=first@example.com,second@example.com
